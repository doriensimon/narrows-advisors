---
interface Props {
  firstName: string;
  lastName: string;
  initials: string;
  recordId: string;
  role: string;
  recordNumber: string;
  photo?: string;
}
const { firstName, lastName, initials, recordId, role, recordNumber, photo } = Astro.props;
---

<div class="banner">
  <div class="photo-slot">
    {photo ? <img src={photo} alt={`${firstName} ${lastName}`} /> : <span class="initials">{initials}</span>}
  </div>
  <div class="identity">
    <span class="name">
      <span class="given">{firstName}</span> <span class="surname">{lastName.toUpperCase()}</span>
    </span>
    <span class="meta">{recordId} &nbsp;|&nbsp; {role} &nbsp;|&nbsp; {recordNumber}</span>
  </div>
</div>

<style>
  .banner {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--pacific-slate);
    padding: 20px 24px;
  }

  .photo-slot {
    width: 68px;
    height: 68px;
    flex: 0 0 68px;
    background: var(--bridge-stone);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .photo-slot img {
    position: absolute;
    inset: -2px;
    width: calc(100% + 4px);
    height: calc(100% + 4px);
    max-width: none;
    object-fit: cover;
  }
  .initials {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--pacific-slate);
  }

  .identity {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .name {
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--fog-white);
  }
  .given {
    font-weight: 400;
  }
  .surname {
    font-weight: 700;
    text-transform: uppercase;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--fog-a60);
  }

  @media (max-width: 860px) {
    .banner {
      padding: 16px 16px;
      gap: 16px;
    }
    .photo-slot {
      width: 56px;
      height: 56px;
      flex-basis: 56px;
    }
    .initials {
      font-size: 18px;
    }
    .name {
      font-size: 20px;
    }
  }
</style>
