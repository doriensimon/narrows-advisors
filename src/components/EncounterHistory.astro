---
import PanelCard from './PanelCard.astro';
import { ABOUT_TIMELINE } from '../data/site';
---

<PanelCard title="Encounter history" padded class="encounter-history">
  <ol>
    {ABOUT_TIMELINE.map((entry, i) => (
      <li>
        <span class="rail">
          {i < ABOUT_TIMELINE.length - 1 && <span class="line"></span>}
          <span class="dot"></span>
        </span>
        <span class="text">
          <span class="title">{entry.title}</span>
          <span class="detail">{entry.detail}</span>
        </span>
      </li>
    ))}
  </ol>
</PanelCard>

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 14px 1fr;
    align-items: start;
    column-gap: 10px;
    padding-bottom: 14px;
  }
  li:last-child {
    padding-bottom: 0;
  }

  .rail {
    position: relative;
    display: block;
    height: 100%;
  }
  .line {
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: -14px;
    width: 1px;
    background: var(--border-subtle);
  }
  .dot {
    position: absolute;
    left: 2px;
    top: 5px;
    width: 7px;
    height: 7px;
    background: var(--ember);
    border-radius: var(--radius-sm);
  }

  .text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .title {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-heading);
    line-height: 1.35;
  }
  .detail {
    font-size: 11.5px;
    color: var(--text-muted);
    line-height: 1.45;
    margin-top: 1px;
  }
</style>
