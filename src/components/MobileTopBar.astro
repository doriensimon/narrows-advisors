---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  subline?: string;
}
const { title, subline } = Astro.props;
---

<div class="mobile-topbar mobile-only">
  <button type="button" class="leading" id="mobile-menu-toggle" aria-expanded="false" aria-controls="mobile-nav-menu" aria-label="Open navigation">
    <Icon name="lucide:menu" width={20} height={20} />
  </button>
  <div class="titles">
    <span class="title">{title}</span>
    {subline && <span class="subline">{subline}</span>}
  </div>
  <span class="search">
    <Icon name="lucide:search" width={18} height={18} />
  </span>
</div>

<style>
  .mobile-topbar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 46px;
    padding: 0 14px;
    background: var(--pacific-slate);
  }

  .leading {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fog-white);
    background: none;
    border: none;
    padding: 0;
    flex: 0 0 auto;
  }

  .titles {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-width: 0;
  }
  .title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--fog-white);
    line-height: 1.3;
  }
  .subline {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fog-a50);
  }

  .search {
    display: flex;
    align-items: center;
    color: var(--fog-a60);
    flex: 0 0 auto;
  }
</style>
