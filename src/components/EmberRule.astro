---
interface Props {
  class?: string;
  style?: string;
}
const { class: className, style } = Astro.props;
---

<div class:list={['ember-rule', className]} style={style}></div>

<style>
  .ember-rule {
    width: var(--ember-rule-width);
    height: var(--ember-rule-height);
    background: var(--rule-accent);
  }
</style>
