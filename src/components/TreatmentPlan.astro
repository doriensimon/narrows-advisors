---
import PanelCard from './PanelCard.astro';
import type { FixItem } from '../data/site';

interface Props {
  items: FixItem[];
}
const { items } = Astro.props;
---

<PanelCard title="Treatment plan" class="treatment-plan">
  {items.map((item) => (
    <div class="row">
      <span class="problem">{item.problem}</span>
      <p class="fix">{item.fix}</p>
    </div>
  ))}
</PanelCard>

<style>
  .row {
    border-bottom: var(--border-inner);
    padding: 14px 18px;
  }
  .row:last-child {
    border-bottom: none;
  }
  .problem {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-heading);
    display: block;
  }
  .fix {
    font-size: 13px;
    line-height: 1.65;
    color: var(--text-muted);
    margin-top: 6px;
  }

  @media (max-width: 860px) {
    .row {
      padding: 12px 14px;
    }
    .problem {
      font-size: 12.5px;
    }
    .fix {
      font-size: 12.5px;
      margin-top: 5px;
    }
  }
</style>
