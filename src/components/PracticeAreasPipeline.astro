---
import PanelCard from './PanelCard.astro';
import { PRACTICE_AREAS } from '../data/site';
---

<PanelCard title="Practice Areas" padded class="pipeline">
  <div class="steps">
    {PRACTICE_AREAS.map((step, i) => (
      <div class="step">
        <span class="label">{step.label}</span>
        <span class="dot"></span>
        {i < PRACTICE_AREAS.length - 1 && <span class="connector"></span>}
      </div>
    ))}
  </div>
</PanelCard>

<style>
  .steps {
    display: flex;
    align-items: flex-start;
    position: relative;
    padding-top: 6px;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1 1 0;
    min-width: 0;
    position: relative;
  }

  .label {
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-heading);
    text-align: center;
    line-height: 1.4;
    padding: 0 4px;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ember);
    flex: 0 0 auto;
    z-index: 1;
    margin-top: 10px;
  }

  .connector {
    position: absolute;
    bottom: 3px;
    left: 50%;
    width: 100%;
    height: 1px;
    background: var(--ember);
    z-index: 0;
  }

  @media (max-width: 860px) {
    .steps {
      flex-direction: column;
      align-items: flex-start;
      padding-left: 4px;
    }
    .step {
      flex-direction: row;
      align-items: center;
      gap: 12px;
      width: 100%;
      padding: 8px 0;
    }
    .label {
      order: 2;
      text-align: left;
      padding: 0;
    }
    .dot {
      order: 1;
      margin-top: 0;
    }
    .connector {
      order: 0;
      position: absolute;
      left: 3px;
      top: 50%;
      bottom: auto;
      width: 1px;
      height: 100%;
    }
  }
</style>
