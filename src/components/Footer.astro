---
import { NAV_ITEMS, TAGLINE, CONTACT_EMAIL, LOCATION, BOOKING_URL } from '../data/site';
const pageLinks = NAV_ITEMS.filter((item) => item.label !== 'Contact');
---

<footer class="site-footer">
  <div class="inner">
    <div class="brand">
      <span class="wordmark">
        <span class="mark">NARROWS</span>
        <span class="sub">ADVISORS</span>
      </span>
      <p class="tagline">{TAGLINE}</p>
    </div>
    <div class="col">
      <div class="col-title">Navigate</div>
      <div class="links">
        {pageLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </div>
    <div class="col">
      <div class="col-title">Contact</div>
      <div class="links">
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        <span class="plain">{LOCATION}</span>
      </div>
    </div>
    <div class="col cta-col">
      <div class="col-title">Start</div>
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="cta">Schedule a Call</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--near-black);
    padding: 28px 24px;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }

  .brand {
    flex: 1 1 220px;
    min-width: 200px;
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    gap: 7px;
  }
  .mark {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: var(--tracking-mark);
    color: var(--fog-white);
  }
  .sub {
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: var(--tracking-sub);
    color: var(--fog-white);
    opacity: 0.5;
  }

  .tagline {
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--fog-a60);
    max-width: 260px;
    margin: 10px 0 0;
  }

  .col {
    flex: 0 0 auto;
  }

  .col-title {
    font-family: var(--font-display);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fog-a50);
    margin-bottom: 8px;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .links a,
  .links .plain {
    font-size: 13.5px;
    color: var(--fog-white);
    opacity: 0.85;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--fog-white);
    border: 1px solid var(--fog-a50);
    border-radius: var(--radius-sm);
    padding: 7px 14px;
  }

  @media (max-width: 860px) {
    .site-footer {
      padding: 24px 18px 18px;
    }
    .inner {
      flex-direction: column;
      gap: 20px;
    }
    .cta {
      justify-content: center;
      padding: 10px 16px;
    }
  }
</style>
