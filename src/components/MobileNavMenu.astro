---
import { Icon } from 'astro-icon/components';
import { MOBILE_NAV_ROWS } from '../data/site';

interface Props {
  active: string;
}
const { active } = Astro.props;
---

<div class="mobile-nav-menu mobile-only" id="mobile-nav-menu" hidden>
  <ul>
    {MOBILE_NAV_ROWS.map((row) => (
      <li>
        <a
          href={row.href}
          target={row.href.startsWith('http') ? '_blank' : undefined}
          rel={row.href.startsWith('http') ? 'noopener' : undefined}
          class:list={['row', { active: row.id === active }]}
        >
          <Icon name={row.icon} width={18} height={18} />
          <span class="text">
            <span class="label">{row.label}</span>
            <span class="meta">{row.meta}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .mobile-nav-menu {
    background: var(--white);
    border-bottom: var(--border-hairline);
  }
  .mobile-nav-menu[hidden] {
    display: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: var(--border-inner);
    color: var(--text-heading);
  }
  .row:hover {
    background: var(--surface-sunken);
    color: var(--text-heading);
  }
  .row.active {
    color: var(--ember);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .label {
    font-size: 14px;
    font-weight: 500;
  }
  .meta {
    font-size: 12px;
    color: var(--text-muted);
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-nav-menu');

  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const isOpen = !menu.hidden;
    menu.hidden = isOpen;
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
