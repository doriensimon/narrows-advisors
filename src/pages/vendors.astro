---
import RecordLayout from '../layouts/RecordLayout.astro';
import IssueGroups from '../components/IssueGroups.astro';
import TreatmentPlan from '../components/TreatmentPlan.astro';
import { VENDOR_PERSONA, VENDOR_ISSUE_GROUPS, VENDOR_FIX } from '../data/site';

const persona = VENDOR_PERSONA;
const metaFields = [
  { label: 'PCP', value: persona.pcp },
  { label: 'Next', value: persona.next },
  { label: 'Provider', value: persona.provider },
  { label: 'Primary', value: persona.primary },
];
---

<RecordLayout
  title="For AI Companies — Narrows Advisors"
  description="Fractional support for AI/RCM vendors selling into revenue cycle."
  activeNav="Vendors"
  activeRail="vendors"
  mobileTitle="For AI Companies"
  persona={persona}
  metaFields={metaFields}
  columns="narrow-left"
>
  <Fragment slot="left">
    <IssueGroups groups={VENDOR_ISSUE_GROUPS} />
  </Fragment>
  <Fragment slot="right">
    <TreatmentPlan items={VENDOR_FIX} />
  </Fragment>
</RecordLayout>
