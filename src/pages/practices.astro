---
import RecordLayout from '../layouts/RecordLayout.astro';
import IssueGroups from '../components/IssueGroups.astro';
import TreatmentPlan from '../components/TreatmentPlan.astro';
import { PRACTICE_PERSONA, PRACTICE_ISSUE_GROUPS, PRACTICE_FIX } from '../data/site';

const persona = PRACTICE_PERSONA;
const metaFields = [
  { label: 'PCP', value: persona.pcp },
  { label: 'Next', value: persona.next },
  { label: 'Provider', value: persona.provider },
  { label: 'Primary', value: persona.primary },
];
---

<RecordLayout
  title="For Practices — Narrows Advisors"
  description="Fractional AI RCM strategy for practice owners and operations leads."
  activeNav="Practices"
  activeRail="practices"
  mobileTitle="Practices"
  persona={persona}
  metaFields={metaFields}
  columns="narrow-left"
>
  <Fragment slot="left">
    <IssueGroups groups={PRACTICE_ISSUE_GROUPS} />
  </Fragment>
  <Fragment slot="right">
    <TreatmentPlan items={PRACTICE_FIX} />
  </Fragment>
</RecordLayout>
